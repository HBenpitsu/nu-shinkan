{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "e2e": {
      "dependsOn": ["^e2e"]
    },
    "env:sync": {
      "dependsOn": ["^env:sync"]
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["^env:sync", "^predeploy", "^deploy"],
      "env": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID", "PR_NUMBER"]
    }
  }
}