{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "ui_test": {
      "dependsOn": ["^ui_test"]
    },
    "ui_test:prepare": {
      "cache": false,
      "dependsOn": ["^ui_test:prepare"]
    },
    "deploy": {
      "cache": false,
      "env": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "DEPLOY_CHANNEL",
        "PR_NUMBER",
        "TARGETS"
      ]
    },
    "build": {
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/app-config/globalRuntimeEnvs.yaml"
      ],
      "outputs": ["wrangler.deploy.jsonc", ".env.deploy", "dist/**"],
      "env": ["DEPLOY_CHANNEL", "PR_NUMBER", "TARGETS"]
    },
    "sync:local": {
      "cache": false
    }
  }
}
