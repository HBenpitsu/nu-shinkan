{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "organization-content-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  "vars": {
    "SELF": "localhost:6174"
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  "env": {
    "release": {
       "vars": {
         "SELF": "xxxxx"
       }
    },
    "staging": {
       "vars": {
         "SELF": "yyyyy"
       }
    },
    "preview": {
       "vars": {
         "SELF": "yyyyy"
       }
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}