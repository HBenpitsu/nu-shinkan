{
  "name": "@repo/general-user-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "tsc -b && vite build",
    "build:release": "pnpm exec env-config-materialize --env release && tsc -b && vite build --mode release",
    "build:staging": "pnpm exec env-config-materialize --env staging && tsc -b && vite build --mode staging",
    "build:preview": "pnpm exec env-config-materialize --env preview && tsc -b && vite build --mode preview",
    "deploy:release": "pnpm run build:release && wrangler deploy --config .generated/wrangler.release.jsonc --minify",
    "deploy:staging": "pnpm run build:staging && wrangler deploy --config .generated/wrangler.staging.jsonc --minify",
    "deploy:preview": "pnpm run build:preview && wrangler deploy --config .generated/wrangler.preview.jsonc --minify",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report --host 0.0.0.0"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@repo/env-config": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-dom": "^5.18.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-react-x": "^5.18.6",
    "globals": "^17.11.0",
    "node": "^26.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
