{
  "name": "@repo/backend-template",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "dev": "wrangler dev --host 0.0.0.0 --port 6173 --inspector-port 9229",
    "build": "wrangler types --env-interface CloudflareBindings",
    "deploy:release": "wrangler deploy --env release --minify",
    "deploy:staging": "wrangler deploy --env staging --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "check-types": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.110.0"
  }
}